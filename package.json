{
  "name": "@okcontract/graph",
  "version": "0.2.0",
  "description": "Directed graph library",
  "private": false,
  "main": "dist/graph.umd.cjs",
  "module": "dist/graph.js",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/graph.js",
      "require": "./dist/graph.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "bun run format && bun build src/index.ts --outfile dist/graph.js --target browser --format esm --minify && bun build src/index.ts --outfile dist/graph.umd.cjs --target browser --format cjs --minify",
    "test": "bun test --parallel",
    "coverage": "bun test --coverage --coverage-reporter=lcov",
    "definitions": "tsc --project tsconfig.build.json",
    "prepublishOnly": "bun run check && bun run test && bun run build && bun run definitions",
    "check": "biome check src",
    "format": "biome check src --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okcontract/graph.git"
  },
  "author": "Henri Binsztok",
  "license": "MIT"
}
